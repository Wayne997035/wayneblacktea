# wayneblacktea — example environment file. Copy to .env, fill in real values.
# NEVER commit .env (already in .gitignore).

# --- Required ---
DATABASE_URL=postgres://USER:PASS@HOST:PORT/DB?sslmode=require
# Must be at least 32 characters. Generate with: openssl rand -hex 32
API_KEY=replace-with-a-long-random-string-at-least-32-chars

# --- Storage ---
# postgres (default) or sqlite.
STORAGE_BACKEND=postgres
# SQLITE_PATH=~/.wayneblacktea/data.db

# --- Workspace scoping (Phase B2) ---
# REQUIRED in postgres mode (the server refuses to start without it).
# For SQLite local mode it remains optional. Run the manual backfill at
# scripts/manual/000011_backfill_workspace_id.psql once to label legacy NULL
# rows; see docs/runbook.md §4 for the SOP.
# WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# USER_ID=wayne

# --- Auto-decision proposer (default ON) ---
# After every mutating MCP tool call where the user has not logged a decision
# in the previous 15 min, the server drafts a pending_proposals row
# (type=decision) via the LLM chain. The user confirms via the existing
# /api/proposals flow. Default ON because the product purpose is automatic
# decision tracking; spam is mitigated by the proposal-queue confirmation step.
# Set to 1 to opt out (e.g. tight LLM budget or noisy workflow).
# WBT_DISABLE_AUTO_DECISIONS=0

# --- HTTP ---
PORT=8080
# Optional comma/space-separated CIDR allowlist for trusted reverse proxies.
# Empty is the safest default: rate limits use the socket peer and ignore spoofable X-Forwarded-For.
# On Railway, leave this empty unless you have a documented proxy CIDR to trust.
# TRUSTED_PROXY_CIDR=
# MUST be explicit origins — wildcard "*" panics at startup (incompatible with cookie auth).
# Local dev example: http://localhost:5173
# Production example: https://your-app.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173

# --- Embedding provider ---
# EMBEDDING_PROVIDER=gemini             # "gemini" (default) or "openai-compatible"
# When EMBEDDING_PROVIDER=gemini:
# GEMINI_API_KEY=...                    # vector search + dedup; skipped (no vector write) if unset
# When EMBEDDING_PROVIDER=openai-compatible (Ollama / vLLM / LM Studio / OpenAI):
# EMBEDDING_BASE_URL=http://localhost:11434   # server root; /v1/embeddings appended automatically
# EMBEDDING_MODEL=nomic-embed-text            # embedding model served at EMBEDDING_BASE_URL
# EMBEDDING_API_KEY=                          # optional — Ollama does not require a key

# --- Optional integrations ---
# DISCORD_BOT_TOKEN=...         # Discord bot session token; required unless DISCORD_ENV=local
# DISCORD_ENV=local            # set to "local" to skip bot startup in local dev (no-op if token is unset)
# DISCORD_GUILD_ID=...          # Discord guild for slash command registration
# DISCORD_ALLOWED_USER_IDS=... # REQUIRED when DISCORD_BOT_TOKEN is set: comma-separated Discord
                               # user IDs allowed to invoke the bot. Fail-closed — an empty
                               # allowlist denies everyone (including the bot owner).
# DISCORD_WEBHOOK_URL=...       # Outbound webhook for scheduled posts
# NOTION_INTEGRATION_SECRET=... # sync_to_notion target; tool errors if unset
# NOTION_DATABASE_ID=...        # Notion database for synced pages

# --- Optional LLM provider chain (Phases 1-4 of docs/openrouter-fallback.md) ---
# Memory-only mode is the default: leave everything below unset and the
# server still runs MCP tools, GTD, learning reviews, etc.
#
# Pick ONE selection mode (or none):
#   AI_PROVIDER=<name>                       — single primary provider
#   AI_FALLBACK_PROVIDERS=<a>,<b>,<c>        — ordered fallback chain
# Valid <name> values: claude, openrouter, groq, openai-compatible.
# When neither is set, the chain auto-resolves to whichever provider keys
# are present (legacy backward-compat: Claude has priority).
# AI_PROVIDER=
# AI_FALLBACK_PROVIDERS=

# --- Provider-specific keys ---
# CLAUDE_API_KEY=...            # Anthropic Claude (classifier / reflection / snapshots)
# GROQ_API_KEY=...              # Groq (Discord /analyze legacy default)
# OPENROUTER_API_KEY=...        # OpenRouter (recommended for low-cost JSON tasks)
# OpenAI-compatible (Ollama / vLLM / LM Studio / DeepSeek / OpenAI direct):
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434   # server root; /v1/chat/completions appended
# OPENAI_COMPATIBLE_MODEL=llama3.2                    # chat model served at BASE_URL
# OPENAI_COMPATIBLE_API_KEY=                          # optional — Ollama does not require a key
# OPENROUTER_MODEL=openrouter/free      # single-model default; safest zero-cost
# OPENROUTER_MODELS=                    # comma list passed as OpenRouter's `models`
#                                       # array (server-side routing: 1 HTTP call,
#                                       # 1 billing event). Use this for *availability
#                                       # / per-model rate limit / latency* failover —
#                                       # NOT to multiply the daily free quota.
#                                       # See docs/openrouter-fallback.md for current
#                                       # recommended free-model chain (rotates as
#                                       # OpenRouter retires models).
