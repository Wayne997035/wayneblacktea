# AI tool config (personal, local only) — AGENTS.md is tracked (repo guide
# for AI coding agents), CLAUDE.md/.claude/ stay local-only.
CLAUDE.md
.claude/
!.claude/settings.json
.mcp.json
.serena/

# wbt-guard per-repo marker file — contains optional db_url, must not be committed.
# See internal/guard/config.go for schema documentation.
.wayneblacktea/config.json

.env*
!.env.example
!.env.sample
.cache/
node_modules/
bin/
dist/
/tmp/
*.log

# DXT package build output (staged by the goreleaser before-hook, outside ./dist
# so goreleaser's "ensuring distribution directory" empty-check still passes).
build/dxt/staging/

# DB credentials
local.yaml
application-local.yml
credentials.json
configs/*.local.*
*.pem
*.key
*.crt
secrets/

# Go build artifacts (root) — binaries go in bin/ via Taskfile
vendor/
*.test
coverage.out
/build/.task/
/server
/discordbot
/wayneblacktea-server
/wayneblacktea-mcp
/wbt-doctor

# Stop hook output
/tmp/wbt-health.json

# Defense-in-depth: never let a stray sed -i.bak from an old run leak
# a substituted WORKSPACE_UUID through the migrations/ tree. The
# operations runbook now copies migrations to /tmp before sed'ing,
# but keep this pattern in case someone follows an older copy of
# docs/operations.md.
migrations/**/*.bak

# SQLite database files (WAL mode creates sidecar files)
*.db
*.db-wal
*.db-shm

# macOS
.DS_Store

# Root-level wbt CLI binary (source lives in cmd/wbt/)
/wbt
